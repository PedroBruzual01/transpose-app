<?xml version="1.0" encoding="utf-8"?>
<!-- Nocturne app background — a subtle radial lift from the base bg color,
     never a flat gradient effect wide enough to read as a "gradient icon". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:startColor="#1E2133"
                android:endColor="#161826" />
        </aapt:attr>
    </path>
</vector>
